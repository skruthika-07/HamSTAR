# Copy to .env and fill in. Never commit .env.

# SQLite works out of the box for local development:
DATABASE_URL=sqlite:///./hamstar.db
# PostgreSQL for production:
# DATABASE_URL=postgresql://user:password@localhost:5432/hamstar

# Mistral: document OCR, concept extraction, question generation
MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-latest
MISTRAL_CHAT_MODEL=ministral-14b-latest

# Groq (console.groq.com): reasoning analysis, follow-ups for generated questions, feedback, marking written answers
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Use a long random string (32+ characters)
JWT_SECRET=
JWT_ALGORITHM=HS256

# Allowed browser origins, comma-separated
FRONTEND_URL=http://localhost:5173

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=20

# A diagnosis or a correction needs MORE than this percentage
UNDERSTANDING_THRESHOLD=70

# Email for password reset codes. With Gmail: turn on 2-step verification, create an app password at
# https://myaccount.google.com/apppasswords and paste it as SMTP_PASSWORD (not your normal password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# shown as the sender; defaults to SMTP_USER
SMTP_FROM=
RESET_CODE_MINUTES=15

# Task deadline reminders (one email, 24 hours before the deadline). Uses the SMTP settings above.
REMINDERS_ENABLED=true
