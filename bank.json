 "misconceptions": [
  {
   "id": "F_ADD_ACROSS",
   "topic": "fractions",
   "name": "Adding across",
   "rule": "Adds numerators together and denominators together.",
   "explanation": [
    "The denominator names the size of each piece. It is a label, not a quantity to add.",
    "Halves and quarters are different-sized pieces, so they have to be renamed to the same size before they can be counted together.",
    "A quick sense check: 1/2 + 1/4 must be more than 1/2. Adding across gives 2/6, which is less than 1/2, so the rule cannot be right."
   ],
   "workedExample": "1/2 + 1/4  →  2/4 + 1/4  →  3/4",
   "cues": [
    "add(ed|ing)?\\s+(the\\s+)?(top|numerator)s?\\s+(and\\s+then|and|then|&)\\s+(add(ed)?\\s+)?(the\\s+)?(bottom|denominator)s?",
    "(top|numerator)s?\\s+(and|&|with)\\s+(the\\s+)?(bottom|denominator)s?\\s+(together|separately|each)",
    "add(ed|ing)?\\s+(straight\\s+)?across",
    "\\d\\s*\\+\\s*\\d\\s*(=|is)\\s*\\d+\\s*(and|,|then)\\s*\\d\\s*\\+\\s*\\d\\s*(=|is)\\s*\\d+"
   ]
  },
  {
   "id": "F_BIGGER_DENOM",
   "topic": "fractions",
   "name": "Bigger denominator, bigger fraction",
   "rule": "Judges the size of a fraction by the size of its denominator.",
   "explanation": [
    "The denominator says how many equal pieces the whole was cut into.",
    "More pieces means each piece is smaller: a fifth of a cake is smaller than a third of the same cake.",
    "With the same numerator, the fraction with the smaller denominator is the larger one."
   ],
   "workedExample": "1/3 vs 1/5  →  thirds are bigger pieces than fifths  →  1/3 > 1/5",
   "cues": [
    "(bigger|larger|greater|higher)\\s+(number|denominator|bottom)",
    "\\b(\\d+)\\s+is\\s+(bigger|larger|greater|more)\\s+than\\s+\\d+\\b",
    "because\\s+(the\\s+)?(denominator|bottom)\\s+is\\s+(bigger|larger|greater|higher)"
   ]
  },
  {
   "id": "F_DIV_NO_FLIP",
   "topic": "fractions",
   "name": "Dividing without inverting",
   "rule": "Treats fraction division as multiplication, without inverting the divisor.",
   "explanation": [
    "Dividing asks \"how many of these fit?\". 3/4 ÷ 1/2 asks how many halves fit into three quarters.",
    "More than one half fits, so the answer must be bigger than 1. Multiplying straight across gives 3/8, which is far too small.",
    "To divide by a fraction, multiply by its reciprocal: flip the second fraction, then multiply."
   ],
   "workedExample": "3/4 ÷ 1/2  →  3/4 × 2/1  →  6/4  →  3/2",
   "cues": [
    "multipl(y|ied|ying)\\s+(the\\s+)?(top|numerator)s?\\s+(and\\s+then|and|then|&)\\s+(the\\s+)?(bottom|denominator)s?",
    "multipl(y|ied|ying)\\s+(straight\\s+)?across",
    "divid(e|ed|ing)\\s+is\\s+(the\\s+)?same\\s+as\\s+multipl",
    "just\\s+multipl(y|ied)"
   ]
  },
  {
   "id": "A_DIST_FIRST",
   "topic": "algebra",
   "name": "Partial distribution",
   "rule": "Multiplies only the first term inside the bracket.",
   "explanation": [
    "A number in front of a bracket multiplies everything inside it, not only the first term.",
    "Think of 3(x + 4) as three copies of (x + 4): x + 4 + x + 4 + x + 4, which is 3x + 12.",
    "Check with a number: if x = 1, 3(1 + 4) = 15. The expression 3x + 4 gives 7, so it cannot be equivalent."
   ],
   "workedExample": "3(x + 4)  →  3·x + 3·4  →  3x + 12",
   "cues": [
    "(multipl(y|ied)|times(ed)?)\\s+(only\\s+)?(the\\s+)?(x|first|variable)",
    "(the\\s+)?(4|number|second|constant)\\s+(stays|stayed|is left|remains)",
    "3\\s*(times|x|\\*|·)\\s*x\\s+(and|then)\\s+(plus|add|keep)"
   ]
  },
  {
   "id": "A_SIGN_DIST",
   "topic": "algebra",
   "name": "Dropping the negative",
   "rule": "Applies a leading minus sign to the first term in the bracket only.",
   "explanation": [
    "A minus in front of a bracket is the same as multiplying the bracket by −1.",
    "That −1 reaches every term inside, so each sign flips: −(x − 2) becomes −x + 2.",
    "Check with a number: if x = 5, 5 − (5 − 2) = 2. The expression 3 − x gives −2, so the signs were not all flipped."
   ],
   "workedExample": "5 − (x − 2)  →  5 − x + 2  →  7 − x",
   "cues": [
    "(removed?|dropp?ed|took\\s+(off|away)|opened?)\\s+(the\\s+)?bracket",
    "minus\\s+(x|the first)",
    "(sign|minus)\\s+(stays|stayed|same)",
    "5\\s*(-|−|minus)\\s*2"
   ]
  },
  {
   "id": "A_SQUARE_SUM",
   "topic": "algebra",
   "name": "Squaring each term",
   "rule": "Squares each term of a binomial separately and drops the middle term.",
   "explanation": [
    "Squaring means multiplying the whole bracket by itself: (x + 5)² is (x + 5)(x + 5).",
    "Each term in the first bracket multiplies each term in the second, which produces two cross terms: 5x and 5x.",
    "Check with a number: if x = 1, (1 + 5)² = 36. The expression x² + 25 gives 26, so the middle term is missing."
   ],
   "workedExample": "(x + 5)²  →  x² + 5x + 5x + 25  →  x² + 10x + 25",
   "cues": [
